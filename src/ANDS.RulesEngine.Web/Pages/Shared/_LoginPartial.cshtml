@if (User.Identity?.IsAuthenticated == true)
{
    <ul class="navbar-nav">
        <li class="nav-item"><span class="nav-link text-dark">@User.Identity!.Name</span></li>
        <li class="nav-item">
            <form method="post" asp-page="/Account/Logout">
                <button type="submit" class="btn btn-link nav-link text-dark">Sign out</button>
            </form>
        </li>
    </ul>
}
else
{
    <ul class="navbar-nav">
        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Account/Login">Sign in</a></li>
    </ul>
}
